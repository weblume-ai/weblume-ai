# Copy to .env (never commit it). One KEY=value per line, no inline comments.
# Real environment variables override this file.

PORT=8787
HOST=127.0.0.1
UPSTREAM_TIMEOUT_MS=60000

# --- Video: Replicate (https://replicate.com/docs/reference/http) ---
REPLICATE_API_TOKEN=
# owner/name for official models, or owner/name:64-char-version for community models.
# The model must accept a text input called "prompt". Check its API tab on replicate.com.
REPLICATE_VIDEO_MODEL=
# Optional extra static inputs as a JSON object, e.g. {"duration":5}. "prompt" always comes from the app.
REPLICATE_VIDEO_EXTRA_INPUT=
# Optional automatic deadline for each job, e.g. 10m or 90s (minimum 5s).
REPLICATE_CANCEL_AFTER=

# --- Images: any OpenAI-compatible POST {IMAGE_API_URL}/images/generations ---
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_TIMEOUT_MS=120000
